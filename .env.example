# Copy this to .env and fill in your values

# From resend.com → API Keys
RESEND_API_KEY=re_your_key_here

# The "from" address — must be a verified domain on Resend
# During testing you can use: onboarding@resend.dev (only delivers to your own email)
FROM_EMAIL=WorkNest <noreply@yourdomain.com>

# Your deployed URL (used in invite links)
APP_URL=https://your-app.onrender.com

# A long random string for signing sessions — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Absolute path to the SQLite database file
# On Render: set to /data/worknest.db after mounting a persistent disk at /data
DB_PATH=/data/worknest.db

# Absolute path to the uploads directory
# On Render: set to /data/uploads after mounting a persistent disk at /data
UPLOADS_DIR=/data/uploads

# ── External ticket API (Inventory Hub) ──────────────────────────────────
# Static server-to-server key for /api/external/tickets. Generate with:
#   node -e "console.log('tk_live_' + require('crypto').randomBytes(24).toString('hex'))"
# Inventory Hub sends it as the `x-tickets-api-key` header. Never commit
# the real value; set it in the hosting env vars only.
TICKETS_API_KEY=

# Optional outbound webhook: on any new message or status change on a
# ticket that came from an external app, POST { event, ticketId, ticket }
# to this URL with header x-tickets-webhook-secret. Both unset = disabled.
TICKETS_WEBHOOK_URL=
TICKETS_WEBHOOK_SECRET=
